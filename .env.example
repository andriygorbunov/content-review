# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Only needed for the LLM labeler (Phase 2). Everything else runs offline
# on the keyword baseline with no credentials at all.

ANTHROPIC_API_KEY=

# Optional — override the pinned model. A moving model is a moving eval,
# so pin it rather than tracking an alias.
# CR_LLM_MODEL=claude-sonnet-5

# Optional — SQLite location. Set this on network/FUSE mounts, where
# SQLite can throw "disk I/O error".
# CR_DB=/tmp/review.db
